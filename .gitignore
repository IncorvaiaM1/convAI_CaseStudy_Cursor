# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/

# Harness output: logs, transcripts, diffs and grades are committed;
# the per-run repo copies and raw event streams are not.
caseStudyRun/runs/*/repo/
caseStudyRun/runs/*/events.ndjson
caseStudyRun/runs/*/stderr.txt
caseStudyRun/runs/*/base.zip

# Editor and agent config (rules files would change how the agent behaves on the task)
.vscode/
.idea/
.cursor/

# Office and OS clutter
~$*
*.tmp
.DS_Store
Thumbs.db
desktop.ini

# LaTeX build output
*.aux
*.log
*.fls
*.fdb_latexmk
*.synctex.gz
*.out
*.bbl
*.blg

# Local credentials and machine-specific state
.env
.env.*
!.env.example
*.pem
*.key
.codex/
.agents/

# Local review and build artifacts
/tmp/
/output/
/build/
paper/reviewed/*.pdf
*.toc
*.nav
*.snm
*.vrb
*.xdv
*.bcf
*.run.xml
